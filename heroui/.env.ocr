# Xinference OCR Service Configuration
# 此檔案包含 OCR 服務的配置資訊

# === 本地端服務（使用 API Key）（已註解） ===
# XINFERENCE_API_URL=http://localhost:9997/v1
# XINFERENCE_API_KEY=

# === 私有雲端服務（TCM3 Studio） ===
XINFERENCE_API_URL=https://tcm3studio.tzuchi-org.tw/v1
XINFERENCE_API_KEY=sk-TzDigital-94800552

# 使用的模型 ID
XINFERENCE_MODEL_ID=qwen2.5-vl-instruct

# 模型參數設定
XINFERENCE_MAX_TOKENS=2000
XINFERENCE_TEMPERATURE=0.1

# OCR 提示詞模板
XINFERENCE_OCR_SYSTEM_PROMPT="你是一個專業的 OCR 文字識別助手，專門處理台灣身分證和銀行存摺的文字識別。"

# 身分證正面 OCR 提示詞
XINFERENCE_ID_FRONT_PROMPT="請識別這張台灣身分證正面的資訊，包括：姓名、身分證字號、出生日期、性別。請以 JSON 格式回傳，格式為：{\"name\": \"姓名\", \"idNumber\": \"身分證字號\", \"birthDate\": \"出生日期\", \"gender\": \"性別\"}"

# 身分證背面 OCR 提示詞
XINFERENCE_ID_BACK_PROMPT="請識別這張台灣身分證背面的戶籍地址資訊，並拆分成三個部分。請以 JSON 格式回傳，格式為：{\"縣市行政區\": \"縣市和鄉鎮區（例：花蓮縣光復鄉）\", \"村里\": \"村或里的名稱（例：大同村）\", \"地址\": \"詳細地址包含鄰和門牌（例：3鄰中正路123號）\"}"

# 銀行存摺 OCR 提示詞
XINFERENCE_BANK_PROMPT="請識別這張銀行存摺的資訊，包括：銀行代碼（3碼數字）、分行代碼（通常是帳號的前3-4碼數字）、分行名稱、帳號、戶名。請以 JSON 格式回傳，格式為：{\"bankCode\": \"銀行代碼（3碼）\", \"branchCode\": \"分行代碼（3-4碼）\", \"branchName\": \"分行名稱\", \"accountNumber\": \"帳號\", \"accountName\": \"戶名\"}"

# 請求超時設定（毫秒）
XINFERENCE_REQUEST_TIMEOUT=30000

# 重試次數
XINFERENCE_MAX_RETRIES=3

# 圖片處理設定
OCR_IMAGE_MAX_WIDTH=1920
OCR_IMAGE_MAX_HEIGHT=1080
OCR_IMAGE_QUALITY=0.9

# 是否啟用 OCR 服務（用於開發/測試環境切換）
ENABLE_OCR_SERVICE=true

# OCR 服務模式：xinference | mock
OCR_SERVICE_MODE=xinference

# 開發環境設定（當 OCR_SERVICE_MODE=mock 時使用）
MOCK_OCR_DELAY=1000
