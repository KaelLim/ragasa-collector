# Whisper STT (語音轉文字) 配置範本
# 複製此檔案為 .env.stt 並填入實際值

# Xinference API 配置（Whisper 主機）
XINFERENCE_API_URL=https://tcm2studio.tzuchi-org.tw/v1
XINFERENCE_API_KEY=sk-TzDigital-xxxxxxxx

# Whisper 模型配置（語音轉文字）
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=zh
WHISPER_MAX_FILE_SIZE=52428800

# 文字處理 LLM（簡繁轉換 + 標點符號標注）
TEXT_PROCESSING_MODEL=Qwen3-Instruct
TEXT_PROCESSING_ENABLED=true

# 註解：
# - XINFERENCE_API_KEY 與 OCR 相同，但主機不同
# - tcm2studio: Whisper STT 主機
# - tcm3studio: OCR 主機
# - Whisper: 語音轉文字（輸出簡體）
# - Qwen3-Instruct: 簡繁轉換 + 標點優化（30B MLX 模型）
# - large-v3-turbo 速度為 40x 實時
# - TEXT_PROCESSING_ENABLED=false 可停用文字優化
